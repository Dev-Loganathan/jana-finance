# --- Database ---
DATABASE_URL=postgresql://jana:jana@localhost:5433/jana_finance

# --- API ---
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
BUSINESS_TIMEZONE=Asia/Kolkata

# --- Auth (generate real values: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# --- Field encryption (32 bytes, base64: openssl rand -base64 32) ---
FIELD_ENCRYPTION_KEY=change-me-32-byte-base64
BLIND_INDEX_KEY=change-me-32-byte-base64

# --- Storage: local | s3 ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Mail (dev: Mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- WhatsApp: mock | cloud ---
WHATSAPP_DRIVER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Seed ---
SEED_SUPERADMIN_EMAIL=superadmin@janafinance.local
SEED_SUPERADMIN_PASSWORD="ChangeMe#12345"
